# Google AI Studio / Gemini API key (used for both dialogue and vision models)
GEMMA_API_KEY=

# Dialogue model — fast text generation for therapist replies (default: gemini-2.5-flash-lite)
# GEMMA_MODEL_ID=gemini-2.5-flash-lite

# Vision model — multimodal for face/body-language/scene analysis (default: gemini-2.5-flash)
# GEMMA_VISION_MODEL_ID=gemini-2.5-flash

# ElevenLabs API key (must include "Text to speech" permission for /api/tts)
ELEVENLABS_API_KEY=

# Optional: TTS model (default eleven_flash_v2_5 = lower latency)
# ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5

# ElevenLabs voice IDs for each psychologist persona
# Find voice IDs at https://elevenlabs.io/app/voice-library or via their API
VOICE_ID_JAMES=
VOICE_ID_MARCUS=
VOICE_ID_ELENA=
VOICE_ID_ANYA=
VOICE_ID_BUTCHER=
VOICE_ID_NEGOTIATOR=
